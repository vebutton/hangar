# Plane CE v1.5.1 — translated from the release docker-compose.yml (service: plane-mq)
[Unit]
Description=Plane plane-mq
PartOf=plane.target

[Container]
ContainerName=plane-mq
Image=docker.io/library/rabbitmq:3.13.6-management-alpine
Network=plane.network
EnvironmentFile=%h/hangar/env/mq.env
Volume=plane-rabbitmq.volume:/var/lib/rabbitmq
PodmanArgs=--memory=384m

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=plane.target
