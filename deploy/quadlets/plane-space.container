# Plane CE v1.5.1 — translated from the release docker-compose.yml (service: space)
[Unit]
Description=Plane space
PartOf=plane.target
Wants=plane-api.service plane-web.service
After=plane-api.service plane-web.service

[Container]
ContainerName=space
Image=docker.io/makeplane/plane-space:v1.5.1
Network=plane.network
PodmanArgs=--memory=256m

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=plane.target
