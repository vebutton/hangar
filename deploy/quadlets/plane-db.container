# Plane CE v1.5.1 — translated from the release docker-compose.yml (service: plane-db)
[Unit]
Description=Plane plane-db
PartOf=plane.target

[Container]
ContainerName=plane-db
Image=docker.io/library/postgres:15.7-alpine
Network=plane.network
EnvironmentFile=%h/hangar/env/db.env
Volume=plane-pgdata.volume:/var/lib/postgresql/data
Exec=postgres -c max_connections=200
PodmanArgs=--memory=512m

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=plane.target
