# Hangar — Plane operator settings. Lives on the VPS at ~/hangar/plane.env (0600).
# Never commit the real file. deploy/scripts/install.sh creates it from this
# example on first run, replacing every __GENERATE__ with a random hex secret,
# then renders the per-service env files into ~/hangar/env/.
#
# Values must be plain (no quotes, no spaces): podman --env-file does no parsing.

# Browser origin through the SSH tunnel (ssh hangar-tunnel → localhost:8090).
WEB_URL=http://localhost:8090
CORS_ALLOWED_ORIGINS=http://localhost:8090
APP_DOMAIN=localhost

# Postgres
POSTGRES_USER=plane
POSTGRES_DB=plane
POSTGRES_PASSWORD=__GENERATE__

# RabbitMQ
RABBITMQ_USER=plane
RABBITMQ_VHOST=plane
RABBITMQ_PASSWORD=__GENERATE__

# Object storage (bundled MinIO-compatible container)
AWS_S3_BUCKET_NAME=uploads
AWS_ACCESS_KEY_ID=__GENERATE__
AWS_SECRET_ACCESS_KEY=__GENERATE__
FILE_SIZE_LIMIT=5242880

# App secrets
SECRET_KEY=__GENERATE__
LIVE_SERVER_SECRET_KEY=__GENERATE__

# Tuning
GUNICORN_WORKERS=1
API_KEY_RATE_LIMIT=60/minute
AUTHENTICATION_RATE_LIMIT=10/minute
